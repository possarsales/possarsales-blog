---
interface Props {
  title: string;
  description: string;
  price: string;
  rating?: string;
  hotlink: string;
  badge?: string;
}

const { title, description, price, rating = "4.8", hotlink, badge = "Recomendado" } = Astro.props;
---

<div class="border border-slate-200 rounded-xl p-6 shadow-md bg-white my-6 max-w-md mx-auto">
  <span class="bg-indigo-100 text-indigo-700 text-xs font-semibold px-2.5 py-1 rounded">{badge}</span>
  <h3 class="text-xl font-bold text-slate-800 mt-2">{title}</h3>
  <p class="text-slate-600 text-sm mt-2">{description}</p>
  
  <div class="flex items-center justify-between mt-4">
    <div>
      <span class="text-xs text-slate-400 block">Precio</span>
      <span class="text-2xl font-black text-slate-900">{price}</span>
    </div>
    <div class="text-amber-500 font-bold text-sm">
      ⭐ {rating} / 5.0
    </div>
  </div>

  <a 
    href={hotlink} 
    target="_blank" 
    rel="noopener noreferrer" 
    class="mt-5 block w-full text-center bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-4 rounded-lg transition-colors"
  >
    Ver Producto en Hotmart
  </a>
</div>